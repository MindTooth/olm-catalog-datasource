{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "config",
    "signaturePolicy"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["channels"],
          "properties": {
            "channels": {"minItems": 1}
          }
        },
        {
          "required": ["sources"],
          "properties": {
            "sources": {"minItems": 1}
          }
        }
      ],
      "properties": {
        "debug": {
          "type": "boolean"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^(?:0|[-+]?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|ms|s|m|h))+)$"
        },
        "refreshTimeout": {
          "type": "string",
          "pattern": "^(?:0|[-+]?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|ms|s|m|h))+)$"
        },
        "parseConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "openshiftGraphURL": {
          "type": "string"
        },
        "openshiftTimeout": {
          "type": "string",
          "pattern": "^(?:0|[-+]?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|ms|s|m|h))+)$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+(?:/[^/]+)?$"
        },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^v?[1-9][0-9]*\\.(?:0|[1-9][0-9]*)$"
          }
        },
        "catalogs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["redhat", "certified", "community"]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "image": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "type": "string",
                "pattern": "^[^/]+/[^/]+(?:/[^/]+)?$"
              }
            }
          }
        }
      }
    },
    "signaturePolicy": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "existingConfigMap"
          ],
          "properties": {
            "existingConfigMap": {
              "minLength": 1
            },
            "existingSecret": {
              "maxLength": 0
            }
          }
        },
        {
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingConfigMap": {
              "maxLength": 0
            },
            "existingSecret": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "existingClaim": {
                "maxLength": 0
              }
            }
          },
          "then": {
            "required": [
              "size"
            ],
            "properties": {
              "size": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|(?:Ki|Mi|Gi|Ti|Pi|Ei)|[kMGTPE]|m)?$"
              }
            }
          }
        }
      ]
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%?$"
            }
          ]
        }
      }
    }
  }
}
